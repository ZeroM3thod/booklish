.abfeat .abeyb{color:inherit;opacity:.85}
.abfeat h2{font:700 clamp(28px,4vw,50px)/1.05 'Outfit',sans-serif;margin-bottom:14px;max-width:12em}
.abfeat p{font:500 clamp(15px,1.6vw,18px)/1.6 'Manrope',Arial,sans-serif;margin-bottom:22px;max-width:30em}
