.ft-logo .ft-mk{flex:none;height:56px;width:auto;transition:transform .3s cubic-bezier(.2,.8,.3,1),filter .3s}
@media(hover:hover){
 .ft-logo:hover .ft-mk{transform:translateY(-4px) rotate(-7deg);filter:drop-shadow(0 8px 6px rgba(0,0,0,.28))}
}
.ft-logo:active .ft-mk{transform:translateY(0) rotate(0) scale(.94);filter:none}
.ft-brand p{font-size:17px;line-height:1.65;font-weight:500;max-width:34ch;margin-bottom:22px}
