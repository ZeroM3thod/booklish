}
g.bk{transform-origin:0 0;will-change:transform}
.hit:active{cursor:grabbing}
.hit:focus:not(:focus-visible){outline:none}
.mbk{width:calc(100% + 10vw);margin:0 -5vw;max-width:none;overflow:hidden}
