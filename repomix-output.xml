.ft-cta small{display:block;color:var(--orange);font-weight:700;font-size:20px;margin-bottom:14px}
.ft-cta h2{font:700 clamp(38px,6vw,96px)/.95 'Outfit',sans-serif}
.ft-cta h2 em{font-style:normal;color:var(--orange)}
.ft-cta p{font-weight:500;line-height:1.6;max-width:44ch;margin-bottom:18px;font-size:18px}
.ft-form{display:flex;align-items:center;height:64px;border:1.5px solid var(--ink);border-radius:36px;padding:0 6px 0 26px;max-width:520px;transition:box-shadow .2s,transform .2s}
.ft-form:focus-within{box-shadow:5px 5px 0 var(--ink);transform:translate(-2px,-2px)}
.ft-form input{flex:1;min-width:0;border:0;outline:0;background:none;font:500 18px 'Manrope',Arial,sans-serif;color:var(--ink)}
