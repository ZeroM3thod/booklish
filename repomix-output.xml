.abw.dkb{background:#1c1c1c;color:#fff}
@media(min-width:900px){
 .abfeat{grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:56px;align-items:center}
}
@media(max-width:640px){
 .abfeat{box-shadow:6px 0 0 #000;margin-right:6px}
 .abchip{font-size:14px;padding:8px 14px}
}
