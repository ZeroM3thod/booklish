.abof .abv{display:flex;flex-direction:column;align-items:flex-start}
.abof .abv p{flex:1;margin-bottom:18px}
.abof .abv .lnk{font-size:14px;padding:9px 18px}
.abchips{display:flex;flex-wrap:wrap;gap:10px}
.abchip{border:1.5px solid var(--ink);border-radius:30px;padding:9px 18px;font:600 15px 'Manrope',Arial,sans-serif;transition:background-color .2s,color .2s,transform .2s}
.abchip:nth-child(3n+1){background:var(--ink);color:var(--bg)}
.abchip:nth-child(3n+2){background:var(--orange);border-color:var(--orange);color:#fff}
