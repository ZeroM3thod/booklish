 #shopv .grid .dl .cd .u small{display:none}
 #shopv .cnt{font-size:12px}
 #shopv .tb{gap:8px}
 #shopv .tb select{padding:9px 10px;font-size:13px;max-width:44vw}
 #shopv #fbtn{padding:9px 12px}
}
#shopv #sd{position:fixed;inset:0;z-index:110;background:rgba(0,0,0,.5);display:flex;align-items:center;justify-content:center;padding:20px}
#shopv #sd[hidden]{display:none}
#shopv .sheet{background:var(--bg);color:var(--ink);border:2px solid var(--ink);border-radius:20px;width:min(420px,100%);max-height:86vh;overflow:auto;padding:24px 24px 14px;box-shadow:8px 0 0 #000;animation:pop .18s ease-out}
#shopv .sh{display:flex;align-items:center;justify-content:space-between;font:700 28px 'Outfit',sans-serif;margin-bottom:8px}
#shopv .sh .x{position:static}
#shopv .so{display:flex;align-items:center;gap:14px;width:100%;text-align:left;border:0;border-bottom:1.5px solid var(--ink);background:none;padding:15px 4px;font:600 17px 'Manrope',Arial,sans-serif}
#shopv .so:last-child{border-bottom:0}
#shopv .so:hover{color:var(--orange)}
#shopv .so i{width:22px;height:22px;border:2px solid var(--ink);border-radius:50%;flex:none;display:flex;align-items:center;justify-content:center}
#shopv .so.on{font-weight:700}
#shopv .so.on i{border-color:var(--orange)}
#shopv .so.on i:after{content:"";width:10px;height:10px;border-radius:50%;background:var(--orange)}
#shopv .so small{margin-left:auto;font:500 13px 'Manrope',sans-serif;opacity:.55}
#shopv #sortb b{font-weight:700;color:var(--orange)}
@media(max-width:640px){
 #shopv #sd{align-items:flex-end;padding:0}
 #shopv .sheet{width:100%;border-radius:20px 20px 0 0;border-bottom:0;box-shadow:none;padding:20px 18px calc(10px + env(safe-area-inset-bottom,0px));animation:up .25s ease-out}
 #shopv .so{padding:16px 2px}
 #shopv #sortb .sl{display:none}
}
#shopv .pc{display:flex;flex-direction:column;min-width:0}
#shopv .grid .meta{flex:1}
#shopv .grid .pr{flex-direction:column;align-items:stretch;flex-wrap:nowrap;gap:8px}
#shopv .grid .pr>span{display:flex;align-items:baseline;gap:6px;white-space:nowrap}
#shopv .grid .pr .sv{display:inline;margin:0}
#shopv .grid .add{width:100%}
#shopv .grid .dl{display:flex;align-items:center;flex-wrap:nowrap;gap:6px;height:46px;margin-top:6px;overflow:hidden}
#shopv .grid .dl .ci{flex:none;margin:0}
#shopv .grid .dl.st{color:var(--ink);opacity:.7;font-size:13px}
#shopv .grid .dl.st i{width:7px;height:7px;border-radius:50%;background:var(--orange);flex:none}
#shopv .cover .cb.of{background:#000;color:#fff;padding:3px 9px;font-size:10px;letter-spacing:.6px;top:12px;right:12px;left:auto;line-height:1.3}
@media(max-width:899px){
 #shopv .grid .dl{height:40px}
 #shopv .grid .dl .cd{font-size:10px;gap:3px}
 #shopv .cover .cb.of{top:8px;right:8px;padding:2px 7px;font-size:9px}
}
@media(max-width:640px){
 #shopv .grid .dl{height:24px;margin-top:4px}
 #shopv .grid .dl .ci{display:none}
 #shopv .grid .dl .cd{font-size:8px;gap:2px}
 #shopv .grid .dl.st{font-size:9px;gap:4px}
 #shopv .grid .dl.st i{width:5px;height:5px}
 #shopv .cover .cb.of{top:5px;right:5px;padding:2px 5px;font-size:7.5px;letter-spacing:.4px}
 #shopv .grid .pr{gap:6px}
 #shopv .grid .pr .sv{font-size:10px}
}
#shopv .sq{border:0;padding:0;border-radius:0;font:inherit;background:none;width:auto}
#shopv .chips{margin-bottom:0}
#shopv .sub{margin-top:0}
#shopv .fb{font:inherit;color:inherit;cursor:auto;border:0;background:none}
#shopv .fb:hover{color:inherit}
#shopv .fb:active{transform:none}
#shopv .pc{animation:none}
#shopv .pcb{display:block;width:100%}
html.dk #shopv .chip.on,html.dk #shopv .chip:hover{color:var(--bg)}
@media(min-width:900px){
 #shopv .grid{grid-template-columns:repeat(auto-fill,minmax(118px,1fr));gap:20px 12px}
 #shopv .grid .cover{font-size:12px;padding:8px;box-shadow:4px 0 0 #000;margin-right:0}
 #shopv .grid .cb{top:6px;left:6px;padding:2px 6px;font-size:8px}
 #shopv .cover .cb.of{top:6px;right:6px;padding:2px 6px;font-size:8px}
 #shopv .grid .meta{font-size:11.5px;margin:9px 0 6px;line-height:1.35}
 #shopv .grid .pr{font-size:12px;gap:6px}
 #shopv .grid .add{padding:7px 8px;font-size:11px}
 #shopv .grid .dl{height:30px;font-size:10px;margin-top:4px}
 #shopv .grid .dl.st{font-size:10px}
 #shopv .grid .dl .cd{font-size:8px;gap:2px}
 #shopv .grid .dl .cd .u small{display:none}
