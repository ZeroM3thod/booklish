.ft-soc a{width:44px;height:44px;border:2px solid var(--ink);border-radius:50%;display:flex;align-items:center;justify-content:center;text-decoration:none;transition:transform .22s cubic-bezier(.2,.8,.3,1),box-shadow .22s}
