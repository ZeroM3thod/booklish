 .ft-form button:hover{transform:translateY(-3px) rotate(-2deg);box-shadow:0 10px 14px rgba(0,0,0,.3)}
}
.ft-form button:active{transform:translateY(0) scale(.95);box-shadow:none}
.ft-note{margin-top:12px;font-size:14px;font-weight:600;opacity:.65}
.ft-trust{display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));border-bottom:2px solid var(--ink)}
.ft-ti{display:flex;gap:16px;align-items:flex-start;padding:28px 24px 28px 0}
.ft-ti+.ft-ti{padding-left:24px;border-left:2px solid var(--ink)}
