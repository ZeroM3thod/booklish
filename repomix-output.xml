 .mbk{width:calc(100% + 5vw);margin:0 -5vw 0 0}
}
.ft{margin-top:24px;border-top:2px solid var(--ink);font-family:'Manrope',Arial,sans-serif;color:var(--ink)}
.ft a,.ft button{font-family:inherit;color:inherit}
