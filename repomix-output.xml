 .ft-soc a:hover{transform:translate(-3px,-3px) rotate(-8deg);box-shadow:4px 4px 0 var(--ink)}
}
.ft-soc a:active{transform:translate(0,0) rotate(0) scale(.94);box-shadow:none}
.ft-col h3{font:700 14px 'Manrope',Arial,sans-serif;letter-spacing:1.4px;text-transform:uppercase;color:var(--orange);margin-bottom:18px}
.ft-col ul{list-style:none}
.ft-col li+li{margin-top:4px}
.ft-lk{display:inline-flex;align-items:center;gap:8px;border:0;background:none;padding:6px 0;font:600 17px 'Manrope',Arial,sans-serif;color:var(--ink);cursor:pointer;text-align:left;position:relative;transition:transform .25s cubic-bezier(.2,.8,.3,1)}
.ft-lk::after{content:"";position:absolute;left:0;right:0;bottom:2px;height:2px;background:currentColor;transform:scaleX(0);transform-origin:right;transition:transform .3s cubic-bezier(.2,.8,.3,1)}
@media(hover:hover){
 .ft-lk:hover{transform:translateX(6px)}
 .ft-lk:hover::after{transform:scaleX(1);transform-origin:left}
}
.ft-lk:active{transform:translateX(3px) rotate(-1.5deg) scale(.97)}
.ft-dot{width:10px;height:10px;border-radius:50%;flex:none;box-shadow:0 0 0 2px var(--bg),0 0 0 3.5px var(--ink)}
.ft-loc{display:flex;align-items:center;gap:10px;margin-top:18px;font-weight:600;font-size:16px}
.ft-mark{padding:24px 0 8px;container-type:inline-size;user-select:none;perspective:900px}
.ft-mark>div{display:flex;justify-content:space-between;font:800 22cqw/.82 'Outfit',sans-serif}
.ft-mark span{display:block;color:transparent;-webkit-text-stroke:1.6px var(--ink);cursor:default;transform-origin:50% 100%;transition:transform .35s cubic-bezier(.2,.8,.3,1),filter .35s}
