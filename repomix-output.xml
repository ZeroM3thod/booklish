<file path="books-for-all/css/common.css">
/* Books for All - Shared by every page: base, navbar, cards, modals, toast, colour picker */
:root{--bg:#fefdfb;--ink:#1c1c1c;--orange:#f47c2c}
*{margin:0;padding:0;box-sizing:border-box}
html,body{background:var(--bg);overflow-x:hidden}
.abs{position:absolute}
.nav-line{left:71px;top:130px;width:1763px;height:2px;background:var(--ink)}
.vdiv{top:36px;width:2px;height:95px;background:var(--ink)}
.link{top:36px;height:95px;display:flex;align-items:center;justify-content:center;font-size:22px;font-weight:500;transform:translateX(-50%)}
.btn{left:1591px;top:37px;width:195px;height:57px;border-radius:29px;background:var(--ink);color:#fff;font-weight:700;font-size:22px;display:flex;align-items:center;justify-content:center}
svg.books{position:absolute;left:0;top:0}
[data-go],[data-act]{cursor:pointer}
.link:hover{opacity:.6}
.btn{transition:background .2s}
.btn:hover{background:#000}
svg.books{pointer-events:none}
#modal[hidden]{display:none}
.bar{display:flex;gap:20px;align-items:center;margin-bottom:18px;font-weight:600}
.sq,.fi{width:100%;border:1.5px solid var(--ink);border-radius:30px;padding:14px 22px;font:500 17px 'Manrope',Arial,sans-serif;background:none;color:var(--ink);outline:0}
.sq{flex:1}
.fi{margin:8px 0}
textarea.fi{border-radius:20px;resize:vertical}
.chips{display:flex;flex-wrap:wrap;gap:10px;margin-bottom:28px}
.chip{border:1.5px solid var(--ink);border-radius:30px;padding:8px 18px;background:none;font:600 15px 'Manrope',Arial,sans-serif;color:var(--ink);cursor:pointer}
