/* Books for All - about us page */
function about(){
 var sg=B.filter(function(b){return !b.items}).length,cm=B.filter(function(b){return b.items}).length;
 var star='<span class="bdg"><svg width="28" height="28" viewBox="-22 -22 44 44" aria-hidden="true"><path d="M0,-20 Q2.5,-2.5 20,0 Q2.5,2.5 0,20 Q-2.5,2.5 -20,0 Q-2.5,-2.5 0,-20Z" fill="#1c1c1c"/></svg></span>';
 var li=function(a){return '<ul class="abl">'+a.map(function(t){return '<li>'+t+'</li>'}).join('')+'</ul>'};
