 .ft-mark span:hover{transform:translateY(-14px) rotate(-3deg);filter:drop-shadow(0 16px 10px rgba(0,0,0,.28))}
 .ft-mark span:nth-child(even):hover{transform:translateY(-14px) rotate(3deg)}
}
.ft-mark span:active{transform:translateY(0) scale(.97);filter:none}
.ft-mark span.flip{animation:ftflip .8s cubic-bezier(.3,.7,.3,1)}
.ft-bot{display:flex;flex-wrap:wrap;gap:14px 32px;align-items:center;justify-content:space-between;border-top:2px solid var(--ink);padding:22px 0 10px;font-weight:600;font-size:15px}
