 var offers=[['BOOKS','Old books, sell and buy','Post the books you have finished, or pick up pre-loved ones at friendly prices.','Browse books','data-go="shop"'],['EDUCATION','Academic and educational books','School, college and university books, admission guides, reference and exam preparation, all in one place.','Browse books','data-go="shop"'],['COACHING','Admission coaching','Guidance and preparation support to help students get ready for admission.','Ask about coaching','data-act="coach"'],['DONATE','Book donation','Give the books you no longer need to students who need them.','Donate books','data-act="donate"'],['BUNDLES','Combos and bundles','Study sets and reading bundles at a lower price than buying one by one.','Browse books','data-go="shop"'],['GUIDANCE','Help choosing a book','Not sure what to pick? Our team of professionals will help you make up your mind.','Meet the team','data-go="team"']];
 var lv=['School books','SSC and HSC','College books','University books','Admission test guides','Medical and engineering','Competitive exams','Language and IELTS','Reference and notes','Novels and general reading','Art and hobby books'];
 var vals=[['01','Fair prices','Pre-loved books cost far less than new ones, and combo deals save even more.'],['02','Honest condition','Every book has a clear grade and detailed notes, so there are no surprises.'],['03','Made for students','Textbooks, guides and reading that students and curious readers actually need.'],['04','A second life','Books that are already printed get read again instead of sitting on a shelf.']];
 vb.innerHTML='<section class="abhero"><div class="abt"><div class="abey">ABOUT US</div><h1 class="abh1">Old books,<br>new readers.</h1><p class="abp">Books for All is a small shop in '+esc(STORE.city.split(',')[0])+' where people sell, donate and buy old books, from school and college textbooks to admission guides and general reading. We also offer admission coaching, so students find the right books and the right guidance in one place.</p><div class="abrow"><button class="sub abbtn" data-act="sell">Post your old books</button><button class="lnk" data-go="shop">Browse books</button></div></div>'+
 '<div class="abk" aria-hidden="true"><div class="cover" style="background-color:'+COL.classic+'">Classic</div><div class="cover" style="background-color:'+COL.modern+'">Modern Art</div><div class="cover" style="background-color:'+COL.nonfiction+';color:#1c1c1c">Non&shy;fiction</div></div></section>'+
 '<section class="abstats"><div><b>'+sg+'</b><span>single books on the shelf</span></div><div><b>'+cm+'</b><span>combo deals to save more</span></div><div><b>2–4</b><span>days delivery across Bangladesh</span></div><div><b>7</b><span>days to return a book</span></div></section>'+
 '<section class="absec"><div class="abeyb">WHAT WE OFFER</div><h2 class="abh2">Books, coaching<br>and a way to give back</h2><div class="abof abvals">'+offers.map(function(o,k){return '<div class="abv" style="animation-delay:'+(k*60)+'ms"><i>'+o[0]+'</i><h4>'+o[1]+'</h4><p>'+o[2]+'</p><button class="lnk" '+o[4]+'>'+o[3]+'</button></div>'}).join('')+'</div></section>'+
 '<section class="absec"><div class="abeyb">EVERY TYPE OF EDUCATIONAL BOOK</div><h2 class="abh2">For every class,<br>every course, every reader</h2><div class="abchips">'+lv.map(function(t){return '<span class="abchip">'+t+'</span>'}).join('')+'</div></section>'+
 '<section class="absec"><div class="abeyb">TWO WAYS TO USE BOOKS FOR ALL</div><h2 class="abh2">Sell what you’ve read.<br>Buy what you need.</h2><div class="abtwo">'+
 '<article class="abc" style="background-color:'+COL.classic+';color:#fff">'+star+'<h3>For sellers</h3><p class="abcl">Got finished books gathering dust? Post them here and pass them on to someone who will read them.</p>'+li(['Tell us the title, author, condition and your price','Pick an honest grade: Fair, Good or Like new','Sell a book on its own or bundle several into a combo','Your book goes to a reader who will really use it'])+'<button class="abw" data-act="sell">Post a book</button></article>'+
 '<article class="abc" style="background-color:'+COL.nonfiction+';color:#1c1c1c">'+star+'<h3>For readers</h3><p class="abcl">Students and book lovers, find great reads for less and know exactly what you are getting.</p>'+li(['Academic, college and general books at pre-loved prices','Every book shows its condition, details and photos','Combo deals when you want more books for less','Cash on delivery, with 7 days to return a book that is not as described'])+'<button class="abw" data-go="shop">Browse books</button></article></div></section>'+
 '<section class="absec"><div class="abfeat" style="background-color:'+COL.nonfiction+';color:#1c1c1c"><div><div class="abeyb">ADMISSION COACHING</div><h2>Getting ready for admission?</h2><p>Our team helps students prepare for school, college and university admission, and picks the right books for the job.</p><button class="abw dkb" data-act="coach">Ask about coaching</button></div>'+li(['Help choosing the right books for your exam','Preparation guidance for school, college and university admission','Study material matched to your level','Your questions answered by our team'])+'</div></section>'+
 '<section class="absec"><div class="abfeat" style="background-color:'+COL.modern+';color:#fff"><div><div class="abeyb">BOOK DONATION</div><h2>Donate books, help a student</h2><p>Finished with your books? Don’t let them gather dust. Donate them and help students who can’t afford new ones.</p><button class="abw" data-act="donate">Donate books</button></div>'+li(['School, college and university books are all welcome','Story books and general reading too','Tell us what you have and we’ll get in touch','Your books go to students who need them'])+'</div></section>'+
 '<section class="absec"><div class="abeyb">HOW IT WORKS</div><h2 class="abh2">Simple for everyone</h2><div class="abhow"><div><h3>If you sell or donate</h3>'+steps([['Tell us about your books','Add the title, author, condition and your price, or tell us you want to donate.'],['Your book gets listed','Sold books get their own page with condition details, photos and delivery information.'],['A reader gets it','The book is wrapped in paper with a protective sleeve and sent on its way.']])+'</div><div><h3>If you buy</h3>'+steps([['Find your book','Search by title or author, or browse Classic, Modern Art and Nonfiction.'],['Check the condition','Read the grade, the details and the photos so you know the exact copy you will receive.'],['Order and relax','Pay cash on delivery. '+esc(STORE.delivery)+'.']])+'</div></div></section>'+
 '<section class="absec"><div class="abeyb">WHY BOOKS FOR ALL</div><h2 class="abh2">Good books, honest deals</h2><div class="abvals">'+vals.map(function(v,k){return '<div class="abv" style="animation-delay:'+(k*70)+'ms"><i>'+v[0]+'</i><h4>'+v[1]+'</h4><p>'+v[2]+'</p></div>'}).join('')+'</div></section>'+
 '<section class="abband"><div class="abeyb">OUR IDEA</div><h2>Regular reading helps you formulate your own thoughts.</h2><p>That is why we keep good books affordable and easy to pass on. When one reader finishes a book, the next reader should be able to pick it up without paying a fortune.</p><button class="abw" data-go="shop">Start reading</button></section>'+
 '<section class="abcta"><h2>Ready to give a book a second life?</h2><div class="abrow"><button class="sub abbtn" data-act="sell">Post your old books</button><button class="lnk" data-act="donate">Donate books</button><button class="lnk" data-go="shop">Browse books</button></div></section>';
}
function route(){mountView(about,false)}
function onDeals(){route()}
applyDeals();tick();setInterval(tick,1000);window.addEventListener('hashchange',route);route();
