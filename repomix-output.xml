.ft-top{display:inline-flex;align-items:center;gap:10px;border:1.5px solid var(--ink);border-radius:30px;padding:9px 18px;background:none;font:700 15px 'Manrope',Arial,sans-serif;color:var(--ink);cursor:pointer;transition:transform .2s cubic-bezier(.2,.8,.3,1),box-shadow .2s}
